# Copy this to .env when the Brev instance is serving.
# Replace <BREV_HOST> with either:
#   * "localhost" if you ran `brev port-forward <instance> --port 5000:5000`
#   * The public hostname Brev assigned when you exposed port 5000 in the console

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=dev_secret_change_me

# === The Brev wire-up ===
VLLM_BASE_URL=http://<BREV_HOST>:5000/v1
VLLM_MODEL=nemotron
ENABLE_NVEXT_HEADERS=true
MOCK_MODE=false
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=90.0

DATABASE_URL=sqlite:///./prdemo.db
PORT=8080
